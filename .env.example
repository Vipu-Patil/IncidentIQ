# Copy this file to .env and adjust if needed.

# Ollama (running natively on your machine, not in Docker, so it can use your GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Will be used starting the RAG/pgvector phase
DATABASE_URL=postgresql://agentforge:agentforge@localhost:5432/agentforge
